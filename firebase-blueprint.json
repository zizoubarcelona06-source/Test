  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account profile owned strictly by the authenticated user"
    },
    "/users/{userId}/devices/{deviceId}": {
      "schema": { "$ref": "#/entities/UserDevice" },
      "description": "Active device sessions belonging strictly to the user"
    },
    "/company_invites/{inviteCode}": {
      "schema": { "$ref": "#/entities/CompanyInvite" },
      "description": "Lookup-by-code documents used to invite employees into a company"
    },
    "/companies/{companyId}": {
      "schema": { "$ref": "#/entities/Company" },
      "description": "Company workspace shared among verified members"
    },
    "/companies/{companyId}/members/{memberUid}": {
      "schema": { "$ref": "#/entities/CompanyMember" },
      "description": "Verified company member directory and assigned RBAC role"
    },
    "/companies/{companyId}/projects/{docId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Company construction projects"
    },
    "/companies/{companyId}/sites/{docId}": {
      "schema": { "$ref": "#/entities/Site" },
      "description": "Company construction work sites"
    },
    "/companies/{companyId}/tasks/{docId}": {
      "schema": { "$ref": "#/entities/ScheduleTask" },
      "description": "Company schedule tasks"
    },
    "/companies/{companyId}/employees/{docId}": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Company employees and live attendance status"
    },
    "/companies/{companyId}/equipment/{docId}": {
      "schema": { "$ref": "#/entities/Equipment" },
      "description": "Company equipment and operational status"
    },
    "/companies/{companyId}/equipment_faults/{docId}": {
      "schema": { "$ref": "#/entities/EquipmentFault" },
      "description": "Company equipment fault reports"
    },
    "/companies/{companyId}/materials/{docId}": {
      "schema": { "$ref": "#/entities/Material" },
      "description": "Company materials and warehouse stock"
    },
    "/companies/{companyId}/expenses/{docId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Finance-restricted company expenses"
    },
    "/companies/{companyId}/invoices/{docId}": {
      "schema": { "$ref": "#/entities/Invoice" },
      "description": "Finance-restricted company invoices"
    },
    "/companies/{companyId}/clients/{docId}": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Company clients"
    },
    "/companies/{companyId}/suppliers/{docId}": {
      "schema": { "$ref": "#/entities/Supplier" },
      "description": "Company suppliers"
    },
    "/companies/{companyId}/chat_channels/{docId}": {
      "schema": { "$ref": "#/entities/ChatChannel" },
      "description": "Company BTP Chat channels"
    },
    "/companies/{companyId}/chat_messages/{docId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Company BTP Chat messages"
    },
    "/companies/{companyId}/notifications/{docId}": {
      "schema": { "$ref": "#/entities/CompanyNotification" },
      "description": "Company alerts and notifications"
    }
  }
}
