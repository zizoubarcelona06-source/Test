{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private Google-authenticated user profile and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "photoUrl": { "type": "string" },
        "role": { "type": "string", "enum": ["مدير عام", "مدير مشاريع", "محاسب مالي", "مهندس موقع"] },
        "branchName": { "type": "string" },
        "preferredLanguageCode": { "type": "string" },
        "activeCompanyId": { "type": "string" },
        "active": { "type": "boolean" },
        "rewardPoints": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "email", "photoUrl", "role", "branchName", "preferredLanguageCode", "activeCompanyId", "active", "rewardPoints", "createdAt", "updatedAt"]
    },
    "UserDevice": {
      "title": "UserDevice",
      "description": "Active device session belonging to a user",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "deviceName": { "type": "string" },
        "deviceModel": { "type": "string" },
        "locationLabel": { "type": "string" },
        "active": { "type": "boolean" },
        "lastActiveAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "deviceName", "deviceModel", "locationLabel", "active", "lastActiveAt", "createdAt"]
    },
    "CompanyInvite": {
      "title": "CompanyInvite",
