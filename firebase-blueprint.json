        "defaultRole": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyId", "companyName", "ownerId", "defaultRole", "active", "createdAt", "updatedAt"]
    },
